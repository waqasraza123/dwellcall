# DwellCall only. Never use HVACLine credentials, database URLs or provider IDs.
APP_ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Independently created Neon project: pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://USER:PASSWORD@DWELLCALL-POOLER-HOST/dwellcall?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DWELLCALL-DIRECT-HOST/dwellcall?sslmode=require
# Leave unset except for a separately provisioned disposable test database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@ISOLATED-TEST-HOST/dwellcall_test?sslmode=require
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300

# Account signup/login with mandatory authenticator MFA. Owner setup: docs/authentication.md.
ACCOUNT_AUTH_ENABLED=false
# Match frontend DWELLCALL_ACCOUNT_PORTAL_SECRET. Different from ADMIN_TOKEN.
ACCOUNT_PORTAL_SECRET=
# Independent Fernet encryption key; retain it to decrypt enrolled authenticators.
ACCOUNT_MFA_ENCRYPTION_KEY=

# Synthetic CSV/JSON intelligence. No feed polling or CRM export is activated.
LISTING_INTELLIGENCE_ENABLED=true
LISTING_MAX_IMPORT_BYTES=2097152
LISTING_MAX_IMPORT_RECORDS=250
LISTING_DAILY_RECORD_LIMIT=5000
LISTING_DAILY_RUN_LIMIT=24
# Optional read-only operator credential. Use a different >=32-character secret.
# Contact values are restricted for this role; ADMIN_TOKEN permits full access.
LISTING_VIEWER_TOKEN=

# Off until independent private provider configuration and owner activation.
RETELL_TEST_AUDIO_ENABLED=false
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_VERSION=
# Generate two different URL-safe random secrets, each at least 32 characters.
RETELL_WEBSOCKET_SECRET=
ADMIN_TOKEN=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

BUSINESS_NAME=DwellCall
SUPPORTED_LOCATION=Austin, TX
CURRENCY=USD
PERSONALITY="Warm, concise and thoughtful. Ask one natural question at a time."
PROPERTY_CATALOG_PATH=data/properties.json

CONVERSATION_MAX_DURATION_SECONDS=180
CONVERSATION_DAILY_SESSION_LIMIT=5
CONVERSATION_MAX_RESPONSES=20
# Zero deliberately blocks activation. Owner sets a conservative cost reservation
# for the selected Retell voice and LLM, plus a daily admission budget, in US cents.
CONVERSATION_RESERVED_COST_CENTS=0
CONVERSATION_DAILY_BUDGET_CENTS=0

# Hero voice/text conversation modes; shared operator auth, audio slot and budgets.
BROWSER_TEXT_ENABLED=false
# Requires RETELL_TEST_AUDIO_ENABLED and its separately pinned web-call agent.
BROWSER_VOICE_ENABLED=false
# Development-only simulation, mutually exclusive with both live browser modes.
BROWSER_MOCK_ENABLED=false

# Private, operator-initiated Retell + Telnyx calling. Both execution modes are off.
# Reuse RETELL_API_KEY, RETELL_WEBSOCKET_SECRET, LLM_API_KEY and ADMIN_TOKEN above.
OUTBOUND_ENABLED=false
# Development/isolated tests only; mutually exclusive with live calling. No HTTP/audio.
OUTBOUND_MOCK_ENABLED=false
OUTBOUND_AGENT_ID=
OUTBOUND_AGENT_VERSION=
OUTBOUND_FROM_NUMBER=
# Comma-separated approved E.164 numbers. Discovery contacts never imply permission.
OUTBOUND_ALLOWED_NUMBERS=
OUTBOUND_SUPPRESSED_NUMBERS=
# Stable, separate >=32-character secret. Preserve across restarts and deployments.
OUTBOUND_HASH_SECRET=
OUTBOUND_ALLOWED_COUNTRIES=["US"]
# US destinations only; international activation is not supported.
OUTBOUND_CONFIRMED_INTERNATIONAL_COUNTRIES=[]
OUTBOUND_DESTINATION_PERMISSIONS_CONFIRMED=false
OUTBOUND_CALLER_ID_CONFIRMED=false
OUTBOUND_SIP_USERNAME=
OUTBOUND_TELNYX_TERMINATION_HOST=sip.telnyx.com
OUTBOUND_PUBLIC_BASE_URL=
OUTBOUND_MAX_DURATION_SECONDS=180
OUTBOUND_RINGING_SECONDS=25
OUTBOUND_DAILY_LIMIT=5
OUTBOUND_NUMBER_DAILY_LIMIT=1
OUTBOUND_COOLDOWN_SECONDS=300
OUTBOUND_RESERVED_COST_CENTS=0
OUTBOUND_DAILY_BUDGET_CENTS=0
OUTBOUND_RETENTION_DAYS=7
# Human transfers are permanently unavailable; only false is accepted.
OUTBOUND_TRANSFER_ENABLED=false
# Legacy carrier recovery settings below cannot enable transfers.
OUTBOUND_HUMAN_NUMBER=
OUTBOUND_TRANSFER_COMPATIBILITY_CONFIRMED=false
OUTBOUND_TRANSFER_CARRIER_LIMIT_CONFIRMED=false
# Owner must configure this bound independently on the carrier; this is not a timer.
OUTBOUND_TRANSFER_MAX_SECONDS=180
OUTBOUND_TRANSFER_RESERVED_COST_CENTS=0

# Optional consultation CRM; GHL/listing sync is deferred to the new Phase 2.
# CRM_PROVIDER currently accepts none|followupboss; do not set gohighlevel yet.
# Real synchronization requires separate owner approval and caller
# permission. Flags are owner attestations, not proof that validation passed.
CRM_PROVIDER=none
CRM_SYNC_ENABLED=false
CRM_OWNER_APPROVED=false
CRM_CORE_VOICE_VERIFIED=false
CRM_AUTOMATIONS_DISABLED_VERIFIED=false
CRM_HASH_SECRET=
CRM_RETENTION_DAYS=7
CRM_MAX_ATTEMPTS=3
FOLLOWUPBOSS_API_KEY=
FOLLOWUPBOSS_SYSTEM_NAME=
FOLLOWUPBOSS_SYSTEM_KEY=
FOLLOWUPBOSS_LEAD_SOURCE=DwellCall Demo

# Optional third CRM provider: CRM_PROVIDER=hubspot (default remains none).
# Account-level Service Key recommended; an existing private app token is also supported.
HUBSPOT_API_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_TOKEN_TYPE=service_key
HUBSPOT_PORTAL_ID=
HUBSPOT_API_VERSION=2026-09
HUBSPOT_DECLARED_SCOPES=[]
HUBSPOT_CUSTOM_FIELDS={}
HUBSPOT_COMPANY_MAPPINGS={}
HUBSPOT_LEAD_SOURCE=DwellCall
HUBSPOT_CLASSIFICATIONS=["DwellCall","Listing Agent"]
HUBSPOT_SCHEMA_CREATION_ENABLED=false
HUBSPOT_AUTO_QUEUE=false
HUBSPOT_DEALS_ENABLED=false
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_ID=
HUBSPOT_QUALIFYING_STATUSES=["active"]
HUBSPOT_QUALIFIED_MIN_LISTINGS=1
HUBSPOT_SYNC_INTERVAL_SECONDS=60
HUBSPOT_REQUESTS_PER_SECOND=4
HUBSPOT_MAX_LOOKUP_PAGES=5
HUBSPOT_PHONE_CALLING_CODES=["1"]
