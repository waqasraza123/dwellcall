# DwellCall only. Never use HVACLine credentials, database URLs or provider IDs.
APP_ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Independently created Neon project: pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://USER:PASSWORD@DWELLCALL-POOLER-HOST/dwellcall?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DWELLCALL-DIRECT-HOST/dwellcall?sslmode=require
# Leave unset except for a separately provisioned disposable test database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@ISOLATED-TEST-HOST/dwellcall_test?sslmode=require
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300

# Off until independent private provider configuration and owner activation.
RETELL_TEST_AUDIO_ENABLED=false
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_VERSION=
# Generate two different URL-safe random secrets, each at least 32 characters.
RETELL_WEBSOCKET_SECRET=
ADMIN_TOKEN=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

BUSINESS_NAME=DwellCall
SUPPORTED_LOCATION=Austin, TX
CURRENCY=USD
PERSONALITY="Warm, concise and thoughtful. Ask one natural question at a time."
PROPERTY_CATALOG_PATH=data/properties.json

CONVERSATION_MAX_DURATION_SECONDS=180
CONVERSATION_DAILY_SESSION_LIMIT=5
CONVERSATION_MAX_RESPONSES=20
# Zero deliberately blocks activation. Owner sets a conservative cost reservation
# for the selected Retell voice and LLM, plus a daily admission budget, in US cents.
CONVERSATION_RESERVED_COST_CENTS=0
CONVERSATION_DAILY_BUDGET_CENTS=0

# Optional CRM. Real synchronization requires separate owner approval and caller
# permission. Flags are owner attestations, not proof that validation passed.
CRM_PROVIDER=none
CRM_SYNC_ENABLED=false
CRM_OWNER_APPROVED=false
CRM_CORE_VOICE_VERIFIED=false
CRM_AUTOMATIONS_DISABLED_VERIFIED=false
CRM_HASH_SECRET=
CRM_RETENTION_DAYS=7
CRM_MAX_ATTEMPTS=3
FOLLOWUPBOSS_API_KEY=
FOLLOWUPBOSS_SYSTEM_NAME=
FOLLOWUPBOSS_SYSTEM_KEY=
FOLLOWUPBOSS_LEAD_SOURCE=DwellCall Demo
