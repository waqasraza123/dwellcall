# Server-side only. No NEXT_PUBLIC credentials.
DWELLCALL_API_BASE_URL=http://localhost:8000
DWELLCALL_BACKEND_ADMIN_TOKEN=
# Separate operator password, at least 32 characters.
DWELLCALL_OPERATOR_PASSWORD=
# Independent signing secret, at least 32 characters.
DWELLCALL_SESSION_SECRET=
# Explicit publication visibility gate for the repository link.
DWELLCALL_GITHUB_LINK_ENABLED=true
