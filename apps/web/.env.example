# Server-side only. No NEXT_PUBLIC credentials.
DWELLCALL_API_BASE_URL=http://localhost:8000
DWELLCALL_BACKEND_ADMIN_TOKEN=
# Matches backend ACCOUNT_PORTAL_SECRET; different from ADMIN_TOKEN (>=32 characters).
DWELLCALL_ACCOUNT_PORTAL_SECRET=
# Email/password + mandatory MFA use Neon-backed revocable account sessions.
# Shared operator passwords and signed legacy operator cookies are no longer used.
# Explicit publication visibility gate for the repository link.
DWELLCALL_GITHUB_LINK_ENABLED=true
